"""
population_zoning.py

Generates population-balanced ZIP-style zones for Uganda National Grid / UGAMAP.

WHY THIS EXISTS
----------------
The previous attempt broke because it tried to redraw the map before it had
real boundary geometry to work with. This module does the actual "distribute
zip codes by population" logic, and it is deliberately dependency-free
(no shapely, no geopandas, no GDAL) so it drops straight into the existing
FastAPI backend on Railway without touching requirements.txt or the
Dockerfile.

WHAT IT NEEDS FROM YOU
-----------------------
1. A GeoJSON FeatureCollection of parish/ward polygons for the area you're
   zoning (e.g. Entebbe Municipality's 4 wards: Kigungu, Kiwafu, Central,
   Katabi). Get this from either:
     - UBOS Geo-Information Services / HDX "Uganda administrative
       boundaries" dataset (parish-level SHP, convert to GeoJSON at
       mapshaper.org if needed)
     - OpenStreetMap via Overpass, if the wards are mapped there
   Each feature needs a "properties.name" matching the ward name.

2. Population per ward, as a simple {"Ward Name": population} dict. Source:
   UBOS NPHC 2024 Explorer (statistics.ubos.org/nphc/drilldown) — drill down
   to County > Subcounty > Parish for exact per-ward 2024 figures. It's a
   live dashboard (JS-rendered), so this has to be pulled manually in a
   browser; I could not scrape it automatically from here.

3. Address points (already have this: entebbe_database.json) — used to
   distribute population *within* a ward when a ward is too populous for
   one zone and needs splitting into sub-zones.

HOW THE ALGORITHM WORKS
-------------------------
1. For each ward polygon, look up its population.
2. If population <= TARGET_MAX_POP, the whole ward becomes one zone.
3. If population > TARGET_MAX_POP, the ward is split into
   ceil(population / TARGET_MAX_POP) sub-zones:
     a. Take every address point that falls inside the ward polygon
        (pure-Python point-in-polygon, ray casting).
     b. Run a small from-scratch k-means over those points' lat/lon to get
        k = number of sub-zones.
     c. Each address is assigned to its nearest cluster -> that's its
        sub-zone.
     d. Each sub-zone's boundary is approximated as the convex hull of its
        points (pure-Python Graham scan), clipped conceptually to the
        parent ward (not geometrically clipped — see NOTE below).
     e. Each sub-zone's population is estimated as
        ward_population * (points_in_subzone / total_points_in_ward).
4. Every resulting zone (whole ward or sub-zone) gets a sequential code:
        UG-<DISTRICT>-Z<NNN>
5. Output is a GeoJSON FeatureCollection of zones, ready to render as a
   population map layer, plus a flat JSON list for the /zones API endpoint.

NOTE ON THE CONVEX-HULL SHORTCUT
----------------------------------
A true population-weighted partition of a polygon (a "population-equal
Voronoi") needs computational geometry libraries this environment doesn't
have installed and can't reach the internet to install. The convex hull of
each cluster's address points is a good practical stand-in: it's visually a
sensible sub-zone shape and it's exact where address coverage is dense
(most of urban Entebbe). If you later get shapely/geopandas onto the
server, swap step 3d for a proper polygon clip — the population math and
code assignment logic don't change.
"""

import json
import math
import random
from collections import defaultdict

TARGET_MAX_POP = 8000  # max population per zone before it gets split
MIN_POP_TO_SPLIT = 1   # wards below TARGET_MAX_POP are never split


# ---------------------------------------------------------------------------
# Geometry helpers (pure Python, no dependencies)
# ---------------------------------------------------------------------------

def point_in_polygon(lon, lat, polygon_coords):
    """Ray-casting point-in-polygon test. polygon_coords is a list of
    [lon, lat] rings as in GeoJSON (first ring = outer, rest = holes)."""
    def in_ring(x, y, ring):
        inside = False
        n = len(ring)
        j = n - 1
        for i in range(n):
            xi, yi = ring[i]
            xj, yj = ring[j]
            intersect = ((yi > y) != (yj > y)) and \
                (x < (xj - xi) * (y - yi) / (yj - yi + 1e-15) + xi)
            if intersect:
                inside = not inside
            j = i
        return inside

    outer = polygon_coords[0]
    if not in_ring(lon, lat, outer):
        return False
    for hole in polygon_coords[1:]:
        if in_ring(lon, lat, hole):
            return False
    return True


def point_in_multipolygon(lon, lat, geometry):
    if geometry["type"] == "Polygon":
        return point_in_polygon(lon, lat, geometry["coordinates"])
    if geometry["type"] == "MultiPolygon":
        return any(point_in_polygon(lon, lat, poly) for poly in geometry["coordinates"])
    return False


def haversine_km(lon1, lat1, lon2, lat2):
    R = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * R * math.asin(math.sqrt(a))


def kmeans(points, k, iterations=50, seed=42):
    """points: list of (lon, lat). Returns list of cluster indices per point."""
    if k <= 1 or len(points) <= k:
        return [0] * len(points)
    rnd = random.Random(seed)
    centers = rnd.sample(points, k)
    assignments = [0] * len(points)
    for _ in range(iterations):
        changed = False
        for i, p in enumerate(points):
            best, best_d = 0, float("inf")
            for c_idx, c in enumerate(centers):
                d = (p[0] - c[0]) ** 2 + (p[1] - c[1]) ** 2
                if d < best_d:
                    best_d, best = d, c_idx
            if assignments[i] != best:
                changed = True
            assignments[i] = best
        new_centers = []
        for c_idx in range(k):
            members = [points[i] for i in range(len(points)) if assignments[i] == c_idx]
            if members:
                lon_avg = sum(m[0] for m in members) / len(members)
                lat_avg = sum(m[1] for m in members) / len(members)
                new_centers.append((lon_avg, lat_avg))
            else:
                new_centers.append(centers[c_idx])
        centers = new_centers
        if not changed:
            break
    return assignments


def convex_hull(points):
    """Graham scan. points: list of (lon, lat). Returns hull as closed ring
    (list of [lon, lat], first == last) suitable for GeoJSON Polygon."""
    pts = sorted(set(points))
    if len(pts) <= 2:
        # Degenerate: pad into a tiny box so it still renders as a polygon
        if not pts:
            return []
        lon, lat = pts[0]
        eps = 0.0008
        return [[lon - eps, lat - eps], [lon + eps, lat - eps],
                [lon + eps, lat + eps], [lon - eps, lat + eps],
                [lon - eps, lat - eps]]

    def cross(o, a, b):
        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

    lower = []
    for p in pts:
        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
            lower.pop()
        lower.append(p)
    upper = []
    for p in reversed(pts):
        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
            upper.pop()
        upper.append(p)
    hull = lower[:-1] + upper[:-1]
    hull.append(hull[0])
    return [[x, y] for x, y in hull]


# ---------------------------------------------------------------------------
# Core zoning logic
# ---------------------------------------------------------------------------

def generate_zones(ward_geojson, ward_population, addresses,
                    district_code="ENT", target_max_pop=TARGET_MAX_POP):
    """
    ward_geojson: GeoJSON FeatureCollection, one Feature per ward, each with
                  properties.name matching a key in ward_population.
    ward_population: dict {ward_name: population_int}
    addresses: list of dicts with at least "latitude" and "longitude" keys
               (matches entebbe_database.json's schema)
    Returns: (zones_geojson, zones_flat_list)
    """
    addr_points = [(a["longitude"], a["latitude"]) for a in addresses
                   if "latitude" in a and "longitude" in a]

    zones = []
    zone_counter = 1

    for feature in ward_geojson["features"]:
        ward_name = feature["properties"].get("name", "Unknown Ward")
        geometry = feature["geometry"]
        population = ward_population.get(ward_name)

        if population is None:
            print(f"WARNING: no population figure for ward '{ward_name}', skipping split logic")
            population = 0

        # Points that fall inside this ward (for splitting + population share)
        pts_in_ward = [p for p in addr_points if point_in_multipolygon(p[0], p[1], geometry)]

        if population <= target_max_pop or len(pts_in_ward) < 2:
            code = f"UG-{district_code}-Z{zone_counter:03d}"
            zone_counter += 1
            zones.append({
                "code": code,
                "ward": ward_name,
                "population": population,
                "geometry": geometry,
            })
            continue

        # Needs splitting
        k = max(2, math.ceil(population / target_max_pop))
        k = min(k, len(pts_in_ward))  # can't have more clusters than points
        assignments = kmeans(pts_in_ward, k)

        clusters = defaultdict(list)
        for pt, cluster_id in zip(pts_in_ward, assignments):
            clusters[cluster_id].append(pt)

        total_pts = len(pts_in_ward)
        for cluster_id, cluster_pts in clusters.items():
            share = len(cluster_pts) / total_pts if total_pts else 0
            sub_population = round(population * share)
            hull_ring = convex_hull(cluster_pts)
            code = f"UG-{district_code}-Z{zone_counter:03d}"
            zone_counter += 1
            zones.append({
                "code": code,
                "ward": ward_name,
                "population": sub_population,
                "geometry": {"type": "Polygon", "coordinates": [hull_ring]},
            })

    zones_geojson = {
        "type": "FeatureCollection",
        "features": [
            {
                "type": "Feature",
                "properties": {
                    "code": z["code"],
                    "ward": z["ward"],
                    "population": z["population"],
                },
                "geometry": z["geometry"],
            }
            for z in zones
        ],
    }
    zones_flat = [
        {"code": z["code"], "ward": z["ward"], "population": z["population"]}
        for z in zones
    ]
    return zones_geojson, zones_flat


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Generate population-balanced ZIP zones")
    parser.add_argument("--wards", required=True, help="Path to ward boundary GeoJSON")
    parser.add_argument("--population", required=True, help="Path to {ward: population} JSON")
    parser.add_argument("--addresses", required=True, help="Path to entebbe_database.json (or similar)")
    parser.add_argument("--district-code", default="ENT")
    parser.add_argument("--target-max-pop", type=int, default=TARGET_MAX_POP)
    parser.add_argument("--out-geojson", default="zip_zones.geojson")
    parser.add_argument("--out-json", default="zip_zones.json")
    args = parser.parse_args()

    with open(args.wards, encoding="utf-8") as f:
        ward_geojson = json.load(f)
    with open(args.population, encoding="utf-8") as f:
        ward_population = json.load(f)
    with open(args.addresses, encoding="utf-8") as f:
        addresses = json.load(f)

    zones_geojson, zones_flat = generate_zones(
        ward_geojson, ward_population, addresses,
        district_code=args.district_code, target_max_pop=args.target_max_pop,
    )

    with open(args.out_geojson, "w", encoding="utf-8") as f:
        json.dump(zones_geojson, f, indent=2)
    with open(args.out_json, "w", encoding="utf-8") as f:
        json.dump(zones_flat, f, indent=2)

    print(f"Generated {len(zones_flat)} zones -> {args.out_geojson}, {args.out_json}")
    for z in zones_flat:
        print(f"  {z['code']}  {z['ward']:<20}  pop={z['population']}")
